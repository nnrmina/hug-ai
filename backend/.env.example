# Copy to backend/.env — everything works without any key (rule-based fallback).
APP_NAME=YAXIN AI
ENVIRONMENT=development

# SQLite by default. For production / Vercel use Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/yaxin_ai
DATABASE_URL=sqlite:///./yaxin_ai.db

# Gemini (free key: https://aistudio.google.com/apikey)
LLM_PROVIDER=auto
GEMINI_API_KEY=
LLM_MODEL_NAME=gemini-3.5-flash-lite

# Random secret so confirmation tokens survive restarts / multiple serverless instances
ACTION_SIGNING_KEY=

DEFAULT_TIMEZONE=Asia/Baku
DEFAULT_LANGUAGE=az-AZ
