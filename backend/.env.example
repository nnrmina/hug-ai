APP_NAME=YAXIN AI
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://yaxin:local_password@localhost:5432/yaxin_ai
FALLBACK_SQLITE_URL=sqlite:///./yaxin_ai.db

# Production: ENVIRONMENT=production refuses to start with SQLite, without JWT_SECRET or with ALLOWED_ORIGINS=*.
# Only for local dev, and only if you accept that data goes to SQLite: ALLOW_SQLITE_FALLBACK=true
ALLOW_SQLITE_FALLBACK=false

# JWT signing secret (>= 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Leave empty in development (a local .dev_jwt_secret file is generated automatically).
JWT_SECRET=
JWT_EXPIRE_DAYS=180

# Access control. If API_KEY is set, clients must send header "X-API-Key".
# Note: a key shipped inside a public web page is not secret — use it for the mobile app / server-to-server.
API_KEY=
# Comma-separated, e.g. https://your-app.vercel.app,http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080

# Intent engine: rules are always on; hug-ml is consulted only when rules return UNKNOWN.
LLM_PROVIDER=rule_based
HUG_ML_URL=
# HUG_ML_URL=http://localhost:8001

# Speech-to-text on the server: none | openai | mock (tests)
# Browsers and the Android app do speech recognition on-device, so "none" is fine for the MVP.
STT_PROVIDER=none
OPENAI_API_KEY=

TTS_PROVIDER=android_native
DEFAULT_TIMEZONE=Asia/Baku
DEFAULT_LANGUAGE=az-AZ
