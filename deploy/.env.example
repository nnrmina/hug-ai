# deploy/.env on the server (never committed). Used by docker compose and the app.

# --- reverse proxy (shared Caddy on the portfelim box) ---
PROXY_NETWORK=portfelim_default
PROXY_CONTAINER=portfelim-caddy-1
PROXY_CADDYFILE=/opt/portfelim/deploy/Caddyfile
APP_HOST=hug.46-224-126-66.sslip.io

# --- app ---
ENVIRONMENT=production
LLM_PROVIDER=auto
GEMINI_API_KEY=
LLM_MODEL_NAME=gemini-3.5-flash-lite
# openssl rand -base64 32 — keeps confirmation tokens valid across restarts
ACTION_SIGNING_KEY=
DEFAULT_TIMEZONE=Asia/Baku
DEFAULT_LANGUAGE=az-AZ

# Web Push (VAPID) — generate once: see DEPLOY.md
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Used in family invite links
PUBLIC_BASE_URL=https://hug.46-224-126-66.sslip.io
